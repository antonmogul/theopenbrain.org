{
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/storybook",
      "destination": "/storybook/index.html",
      "type": 302
    },
    {
      "source": "/styleguide",
      "destination": "/storybook/index.html",
      "type": 301
    }
  ],
  "rewrites": [{ "source": "**", "destination": "/index.html" }],
  "headers": [
    {
      "source": "publicAssets/**",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "assets/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
