{
  "name": "theopenbrain.org",
  "version": "0.1.20",
  "scripts": {
    "postversion": "npm run deploy",
    "clean": "npm cache clean --force && rm -rf node_modules package-lock.json && npm i --legacy-peer-deps",
    "start": "npm run watch:local",
    "watch:local": "NODE_ENV=development vite --force --mode development",
    "build": "NODE_ENV=production vite build",
    "preview": "vite preview --port 4173",
    "serve:dev": "npm run build:dev && NODE_ENV=development vite preview",
    "serve:stage": "npm run build:stage && NODE_ENV=staging vite preview",
    "serve:prod": "npm run build:prod && NODE_ENV=production vite preview",
    "clear:dist": "rm -rf dist",
    "prebuild": "npm run clear:dist",
    "build:dev": "npm run prebuild && NODE_ENV=development vite build --mode development",
    "build:stage": "npm run prebuild && NODE_ENV=staging vite build --mode staging",
    "build:prod": "npm run prebuild && NODE_ENV=production vite build",
    "test:e2e": "start-server-and-test preview http://localhost:4173/ 'cypress open --e2e'",
    "test:e2e:ci": "start-server-and-test preview http://localhost:4173/ 'cypress run --e2e'",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix",
    "deploy": "bash ./deploy.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "graph:orphans": "npx -y madge@8.0.0 --webpack-config madge.webpack.cjs --extensions js,ts,vue --orphans src",
    "graph:cycles": "npx -y madge@8.0.0 --webpack-config madge.webpack.cjs --extensions js,ts,vue --circular src",
    "graph:check": "npx -y dependency-cruiser@16.10.4 --config .dependency-cruiser.cjs --output-type err src",
    "graph:visual": "npx -y madge@8.0.0 --webpack-config madge.webpack.cjs --extensions js,ts,vue --json src > docs/architecture/graph.json",
    "lint:ci": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --max-warnings=120",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ci": "vitest run --reporter=default",
    "smoke": "node scripts/smoke.mjs",
    "test:smoke": "start-server-and-test preview http://localhost:4173 smoke",
    "storybook": "storybook dev -p 6006",
    "storybook:coverage": "node scripts/check-storybook-coverage.mjs",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@formkit/auto-animate": "^1.0.0-beta.3",
    "@google/model-viewer": "^4.3.1",
    "@rushstack/eslint-patch": "^1.2.0",
    "@supabase/supabase-js": "^2.87.1",
    "@tiptap/extension-code-block-lowlight": "^3.13.0",
    "@tiptap/extension-image": "^3.13.0",
    "@tiptap/extension-link": "^3.13.0",
    "@tiptap/extension-placeholder": "^3.13.0",
    "@tiptap/starter-kit": "^3.13.0",
    "@tiptap/vue-3": "^3.13.0",
    "@vueuse/core": "^9.12.0",
    "chart.js": "^4.5.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "file-saver": "^2.0.5",
    "gsap": "^3.11.3",
    "lottie-web": "^5.9.6",
    "mammoth": "^1.11.0",
    "marked": "^17.0.3",
    "pinia": "^2.0.23",
    "pyodide": "^0.29.2",
    "serve": "^14.2.6",
    "three": "^0.185.1",
    "vue": "^3.2.38",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/vue3-vite": "^10.5.8",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.12",
    "cypress": "^15.9.0",
    "eslint": "^8.29.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-cypress": "^2.12.1",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-storybook": "^10.5.8",
    "eslint-plugin-vue": "^9.8.0",
    "happy-dom": "^13.10.1",
    "postcss": "^8.4.17",
    "prettier": "^3.9.6",
    "start-server-and-test": "^2.1.3",
    "storybook": "^10.5.8",
    "tailwindcss": "^3.1.8",
    "vite": "^5.4.21",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
